{
  "manifest_version": 3,
  "name": "Historical Price Tag",
  "version": "1.0.0",
  "description": "See any price on the web (USD, GBP, EUR, KSh) reframed in another year's money, adjusted for inflation using official CPI data.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["cpi-data.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
